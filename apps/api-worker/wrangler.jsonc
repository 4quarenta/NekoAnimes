{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nekoanimes-api-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  "observability": { "enabled": true },
  "vars": {
    "NODE_ENV": "production",
    "APP_MODE": "streaming",
    "WEB_APP_URL": "https://nekoanimes-staging.pages.dev",
    "ANDROID_LATEST_VERSION_CODE": "10000",
    "ANDROID_LATEST_VERSION_NAME": "1.0.0"
  },
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "REPLACE_AFTER_SUPABASE_PROJECT_CREATION" }
  ]
}
